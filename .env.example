# 站点地址（用于 sitemap / OG / 绝对链接）
SITE_URL=http://localhost:3100

# 数据库文件（默认 ./data/app.db）
DATABASE_URL=./data/app.db

# 鉴权密钥：随便一个 32+ 位随机串，生产环境必须换
AUTH_SECRET=change-me-to-a-random-32-char-string

# 后台子域名（推荐）。设了它：
#   - admin.xxx.com 根路径就是后台，/users 这类路径自动映射到 /admin/users
#   - 主域的 /admin 会 301 跳到子域名
# 不设则沿用路径方式 /admin
# ADMIN_HOST=admin.ttals.com
# SITE_HOST=ttals.com

# 不想用子域名时的路径方案（默认 admin）。改成只有自己知道的路径
# ADMIN_PATH=admin

# 是否开放公开注册（默认开放）。false 时只能由管理员建号
# ALLOW_REGISTRATION=true
