[Unit]
Description=Xiaomo · sync GitHub star snapshots
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/xiaomo
# 用 www-data 跑，保证写入 data/app.db 的权限一致
User=www-data
Group=www-data
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c "/usr/bin/env node --use-system-ca --import tsx scripts/sync-github-stars.mjs; /usr/bin/env node --use-system-ca scripts/sync-github-trending.mjs"
StandardOutput=append:/var/log/xiaomo-stars.log
StandardError=append:/var/log/xiaomo-stars.log
