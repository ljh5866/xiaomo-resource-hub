# 站点地址（用于 sitemap / OG / 绝对链接）
SITE_URL=http://localhost:3100

# 数据库文件（默认 ./data/app.db）
DATABASE_URL=./data/app.db

# 鉴权密钥：随便一个 32+ 位随机串，生产环境必须换
AUTH_SECRET=change-me-to-a-random-32-char-string

# ───────── 邮件（注册验证码）─────────
# QQ 邮箱：设置 → 账号 → 开启 POP3/SMTP 服务 → 生成「授权码」
# SMTP_PASS 填授权码，不是 QQ 密码
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your-number@qq.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_FROM="小莫资源网 <your-number@qq.com>"

# 本地/CI 用：不真发邮件，验证码写进 data/.dev-emails.log（生产不要开）
# EMAIL_DEV_MODE=1

# ───────── 后台 ─────────
# 后台子域名（推荐）：设了它，admin.xxx.com 根路径就是后台
# ADMIN_HOST=admin.ttals.com
# SITE_HOST=ttals.com
# 不用子域时的路径方案（默认 admin）
# ADMIN_PATH=admin

# 是否开放公开注册（默认开放）
# ALLOW_REGISTRATION=true

# GitHub OAuth（站内 Star 用）
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# 回调地址：https://你的域名/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=