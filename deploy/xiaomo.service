[Unit]
Description=Xiaomo Resource Hub (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/xiaomo
Environment=NODE_ENV=production
Environment=PORT=3100
EnvironmentFile=/var/www/xiaomo/.env
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=3
# 内存兜底：异常增长时重启而不是拖垮机器
MemoryMax=1G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
