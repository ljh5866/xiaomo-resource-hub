[Unit]
Description=Xiaomo Resource Hub (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/xiaomo
Environment=NODE_ENV=production
Environment=PORT=3100
# www-data 的 HOME 默认是 /var/www（不可写），corepack/pnpm 会因此 EACCES
Environment=HOME=/var/www/xiaomo
EnvironmentFile=/var/www/xiaomo/.env
# 直接用 node 跑 next，绕开 corepack shim：不依赖 PATH、不依赖 HOME 可写
ExecStart=/usr/bin/node /var/www/xiaomo/node_modules/next/dist/bin/next start
Restart=always
RestartSec=3
# 内存兜底：异常增长时重启而不是拖垮机器
MemoryMax=1G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
