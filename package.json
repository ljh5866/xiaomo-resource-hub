{
  "name": "xiaomo-resource-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-all.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "node scripts/migrate.mjs && tsx src/scripts/reindex.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "user:add": "tsx src/scripts/add-user.ts",
    "user:revoke": "tsx src/scripts/revoke-user.ts",
    "seed:bulk": "tsx src/scripts/seed-bulk.ts",
    "import:links": "tsx src/scripts/make-csv.ts",
    "db:clean:content": "tsx src/scripts/clean-content.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:taxonomy": "tsx src/scripts/seed-taxonomy.ts",
    "db:reindex": "tsx src/scripts/reindex.ts",
    "links:check": "tsx src/scripts/check-links.ts",
    "covers:gen": "tsx src/scripts/gen-covers.ts",
    "covers:gc": "tsx src/scripts/covers-gc.ts",
    "backup": "node scripts/backup.mjs",
    "test": "node --import tsx --test tests/tokenize.test.ts tests/extract-code.test.ts tests/utils.test.ts tests/password.test.ts tests/seo.test.ts tests/csv.test.ts tests/email-code.test.ts tests/admin-routing.test.ts",
    "db:reset": "node -e \"require('node:fs').rmSync('./data/app.db',{force:true})\" && pnpm db:push && pnpm db:seed"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.6",
    "lucide-react": "^0.544.0",
    "next": "16.4.4",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.5",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
